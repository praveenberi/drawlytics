# Used by docker-compose.yml (copy to .env next to it). For local development without Docker use server/.env instead.
JWT_SECRET=replace-with-at-least-32-random-characters-xxxxxxxxxxxx
POSTGRES_PASSWORD=change-this-database-password
SEED_ADMIN_EMAIL=admin@drawlytics.local
SEED_ADMIN_PASSWORD=ChangeThisAdminPassword1
SEED_SAMPLE_DRAWS=true
# Set to true once the site is served over HTTPS
FORCE_HTTPS=false
