# Copy to .env and edit. Never commit .env.
NODE_ENV=development
PORT=4000

# PostgreSQL connection string (Prisma)
DATABASE_URL="postgresql://drawlytics:drawlytics@localhost:5432/drawlytics?schema=public"

# JWT – use a long random value (>= 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# Browser origin(s) allowed by CORS (comma separated). Not needed when the server serves the built client.
CLIENT_ORIGIN="http://localhost:5173"

# Seed admin account (used by `npm run db:seed`)
SEED_ADMIN_EMAIL="admin@drawlytics.local"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
# true = create clearly-labelled SAMPLE draws for demo purposes (never real results)
SEED_SAMPLE_DRAWS="true"

# Set true when the site is served over HTTPS (secure cookies + HSTS)
FORCE_HTTPS=false

# true only when all traffic comes through Cloudflare (reads the visitor IP from CF-Connecting-IP)
TRUST_CLOUDFLARE=false

# Upload limits
MAX_UPLOAD_MB=5
MAX_IMPORT_ROWS=20000
