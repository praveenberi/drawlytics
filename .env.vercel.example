# Environment variables for Vercel (Project → Settings → Environment Variables).
# Set them for the "Production" environment (and Preview if you want preview deployments to work).
# Never commit real values.

# --- Required (runtime) ---
NODE_ENV=production
# Pooled PostgreSQL connection string (Neon "pooled", Supabase transaction pooler :6543, Prisma Accelerate, ...).
# Add connection_limit=1 for serverless, plus pgbouncer=true for Supabase/PgBouncer poolers.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DBNAME?sslmode=require&connection_limit=1
# >= 32 random characters:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Secure cookies + HSTS. The site is HTTPS-only on Vercel / Cloudflare, so keep true.
FORCE_HTTPS=true

# --- Required for Cloudflare in front of Vercel ---
# true only if the domain is proxied (orange cloud) AND nobody uses the *.vercel.app URL for real traffic
# (see docs/DEPLOYMENT.md). Makes rate limiting / audit logs use the visitor IP from CF-Connecting-IP.
TRUST_CLOUDFLARE=true

# --- Recommended ---
# Vercel rejects request bodies over 4.5 MB, so keep the upload limit below that.
MAX_UPLOAD_MB=4
MAX_IMPORT_ROWS=20000
JWT_EXPIRES_IN=7d
# Same-origin deployment, so CORS is not needed; set it to your domain only if the API is called from elsewhere.
CLIENT_ORIGIN=https://drawlytics.com

# --- Optional: automatic migrations on production deploys ---
# DIRECT (non-pooled) connection string. When set, every production build runs `prisma migrate deploy`.
# Leave unset to run migrations yourself:  DATABASE_URL=<direct url> npm run db:migrate
MIGRATE_DATABASE_URL=

# --- NOT for Vercel: seed settings. Used once from your own machine (see docs/DEPLOYMENT.md) ---
# SEED_ADMIN_EMAIL, SEED_ADMIN_PASSWORD, SEED_SAMPLE_DRAWS=false
